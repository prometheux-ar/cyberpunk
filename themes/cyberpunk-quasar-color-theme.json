  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#993333"
      }
    },
    {
      "scope": [
        "constant",
        "variable.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ff9900"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5f0000"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#CCFF00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#FF9966"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#ffcc00"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#ff6666"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff00ff"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#5f0000",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.underline",
        "markup.link"
      ],
      "settings": {
        "foreground": "#FF9966",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#5f0000",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff6666"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#ff9900",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw"
      ],
      "settings": {
        "foreground": "#CCFF00"
      }
    }
  ]
}
